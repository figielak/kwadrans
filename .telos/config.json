{
  "version": 2,
  "stack": [
    "typescript"
  ],
  "checks": {
    "build": "pnpm run build",
    "types": "pnpm run typecheck",
    "test": "pnpm run test"
  },
  "limits": {
    "status_lines": 40,
    "map_tokens": 1500,
    "area_tokens": 800,
    "history_entries": 30
  },
  "git": {
    "auto_commit": true,
    "phase_tags": true
  },
  "files_language": "en"
}
